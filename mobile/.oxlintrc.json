{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "node"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": ["ErrorBoundary", "unstable_settings"]
      }
    ],
    "node/no-process-env": "error"
  },
  "overrides": [
    {
      "files": ["src/core/env.ts", "src/core/env.test.ts", "jest.setup.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["src/components/**/*.tsx", "src/ui/**/*.tsx"],
      "plugins": ["unicorn"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "pascalCase",
            "ignore": ["^index\\.tsx$", "^index\\.test\\.tsx$"]
          }
        ]
      }
    }
  ]
}
