{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.3/.schema/devbox.schema.json",
  "packages": [
    "gh@latest",
    "python@3.14",
    "nodejs@24",
    "go@1.27",
    "buf@latest",
    "sops@latest",
    "age@latest",
    "uv@latest",
    "squawk@latest",
    "jdk17@latest",
    "cocoapods@latest",
    "maestro@latest"
  ],
  "env": {
    "GH_CONFIG_DIR": "$DEVBOX_PROJECT_ROOT/.devbox-state/gh",
    "MAESTRO_CLI_NO_ANALYTICS": "1",
    "MAESTRO_DISABLE_UPDATE_CHECK": "1"
  },
  "shell": {
    "init_hook": [
      "unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN",
      "mkdir -p \"$GH_CONFIG_DIR\"",
      "git config core.hooksPath .githooks",
      "source \"$DEVBOX_PROJECT_ROOT/scripts/xcode-env.sh\""
    ],
    "scripts": {}
  }
}
